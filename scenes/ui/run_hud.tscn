[gd_scene format=3]

[ext_resource type="StyleBox" path="res://resources/inset.tres" id="inset"]
[ext_resource type="StyleBox" path="res://resources/scoreblue.tres" id="blue"]
[ext_resource type="StyleBox" path="res://resources/scorered.tres" id="red"]
[ext_resource type="FontFile" path="res://assets/fonts/SpaceMono-Bold.ttf" id="mono"]
[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="script"]

[node name="RunHUD" type="PanelContainer"]
custom_minimum_size = Vector2(264, 0)
script = ExtResource("script")

[node name="Stats" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12


[node name="Eyebrow" type="Label" parent="Stats"]
unique_name_in_owner = true
layout_mode = 2
text = "CURRENT BLIND"
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.54, 0.69, 0.62, 1)
horizontal_alignment = 1

[node name="BlindTitle" type="Label" parent="Stats"]
unique_name_in_owner = true
layout_mode = 2
text = "Small Blind"
theme_override_font_sizes/font_size = 29
horizontal_alignment = 1

[node name="BlindRule" type="Label" parent="Stats"]
unique_name_in_owner = true
layout_mode = 2
text = "A little luck. A good beginning."
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.54, 0.69, 0.62, 1)
horizontal_alignment = 1
autowrap_mode = 2

[node name="Target" type="PanelContainer" parent="Stats"]
layout_mode = 2
theme_override_styles/panel = ExtResource("inset")

[node name="TargetValues" type="VBoxContainer" parent="Stats/Target"]
layout_mode = 2
theme_override_constants/separation = 12


[node name="TargetHint" type="Label" parent="Stats/Target/TargetValues"]
unique_name_in_owner = true
layout_mode = 2
text = "SCORE AT LEAST"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.54, 0.69, 0.62, 1)
horizontal_alignment = 1

[node name="TargetValue" type="Label" parent="Stats/Target/TargetValues"]
unique_name_in_owner = true
layout_mode = 2
text = "300"
theme_override_font_sizes/font_size = 39
theme_override_fonts/font = ExtResource("mono")
horizontal_alignment = 1

[node name="Reward" type="Label" parent="Stats/Target/TargetValues"]
unique_name_in_owner = true
layout_mode = 2
text = "REWARD  $3"
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.89, 0.74, 0.45, 1)
horizontal_alignment = 1

[node name="RoundHeading" type="HBoxContainer" parent="Stats"]
layout_mode = 2
theme_override_constants/separation = 12


[node name="RoundHeadingLabel" type="Label" parent="Stats/RoundHeading"]
unique_name_in_owner = true
layout_mode = 2
