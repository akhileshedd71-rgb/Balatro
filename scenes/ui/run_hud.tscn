[node name="ScoreValue" type="Label" parent="Stats/RoundHeading"]
unique_name_in_owner = true
layout_mode = 2
text = "0"
theme_override_font_sizes/font_size = 24


[node name="Progress" type="ProgressBar" parent="Stats"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 5)
show_percentage = false
mouse_filter = 2

[node name="HandName" type="Label" parent="Stats"]
unique_name_in_owner = true
